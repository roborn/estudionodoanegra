---
import { useTranslations, Language } from "@i18n/utils";

interface Props {
  lang?: Language;
}

const lang = Astro.props.lang || 'pt';
const t = useTranslations(lang);
---

<div class="mt-16 md:mt-0">
  <h3 class="text-3xl lg:text-4xl font-medium lg:tracking-tight">
    {t('features.title')}
  </h3>
  <p class="text-lg mt-4 text-slate-800" set:html={t('features.description_1')} />
  <p class="text-lg mt-4 text-slate-800" set:html={t('features.description_2')} />
</div>

