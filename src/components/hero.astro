---
import { Picture } from "@astrojs/image/components";
import Logo from "assets/logo-nodoa-negra.png";
import { useTranslations, Language } from "@i18n/utils";

interface Props {
  lang?: Language;
}

const lang = Astro.props.lang || 'pt';
const t = useTranslations(lang);
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="md:block mb-10 md:mt-10 md:mr-10">
    <Picture
      src={Logo}
      alt={t('common.brand_full')}
      widths={[275, 550, 1100]}
      aspectRatio="2147:1536"
      sizes="(max-width: 800px) 100vw, 500px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-2xl lg:text-4xl font-medium lg:tracking-tight xl:tracking-tighter mt-1">
      {t('hero.title')}
    </h1>
    <p class="text-lg mt-4 text-slate-900 max-w-xl" set:html={t('hero.description_1')} />
    <p class="text-lg mt-4 text-slate-900 max-w-xl" set:html={t('hero.description_2')} />
    <p class="text-lg mt-4 text-slate-900 max-w-xl" set:html={t('hero.description_3')} />
  </div>
</main>
