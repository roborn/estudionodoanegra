---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Pricing from "@components/pricing.astro";
import { Icon } from "astro-icon";
import { useTranslations, Language, getLocalizedPath } from "@i18n/utils";

interface Props {
  lang?: Language;
}

const lang = Astro.props.lang || 'pt';
const t = useTranslations(lang);

const pricing = [
  {
    name: t('pricing.group_title'),
    price: t('pricing.group_price'),
    popular: true,
    features: [
      t('pricing.group_features_1'),
      t('pricing.group_features_2'),
      t('pricing.group_features_3'),
    ],
    button: {
      text: t('pricing.group_button'),
      link: getLocalizedPath("/treino-grupo", lang),
    },
  },
  {
    name: t('pricing.individual_title'),
    price: t('pricing.individual_price'),
    popular: true,
    features: [
      t('pricing.individual_features_1'),
      t('pricing.individual_features_2'),
      t('pricing.individual_features_3'),
    ],
    button: {
      text: t('pricing.individual_button'),
      link: getLocalizedPath("/treino-individual", lang),
    },
  },
];
---

<Container>
  <Sectionhead>
    <Fragment slot="title">{t('training.title')}</Fragment>
    <Fragment slot="desc">
      <p class="text-lg mb-1">{t('training.description')}</p>
      <p class="" set:html={t('training.note')} />
    </Fragment>
  </Sectionhead>

  <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-screen-lg mt-12">
    {pricing.map((item) => <Pricing plan={item} />)}
    <p>{t('training.benefits')} <Icon class="text-secondary w-5 h-5 mb-1 inline-block" name="bx:bx-coffee" /></p>
  </div>
</Container>