---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import LanguageSwitcher from "@components/languageswitcher.astro";
import { getLangFromUrl, useTranslations, getAlternateUrls } from "@i18n/utils";
import "@fontsource/inter/variable.css";

export interface Props {
  title: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const alternateUrls = getAlternateUrls(Astro.url.pathname, Astro.site?.toString() || 'https://estudionodoanegra.com');

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + t('common.brand_full')
  : t('common.brand_full') + " — " + t('common.slogan');

const metaDescription = t('common.brand_full') + " — " + t('common.slogan');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#3C3C3C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    {alternateUrls.map(({ hreflang, url }) => (
      <link rel="alternate" hreflang={hreflang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls.find(a => a.lang === 'pt')?.url} />
    
    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@estudionodoanegra",
        site: "@estudionodoanegra",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Nódoa Negra — ${t('common.slogan')}`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: t('common.brand_full'),
        },
      }}
    />
  </head>
  <body class="bg-primary text-secondary">
    <div class="relative z-50">
      <Navbar lang={lang} />
    </div>
    <slot />
    <Footer lang={lang} />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
