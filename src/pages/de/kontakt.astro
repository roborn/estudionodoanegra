---
import { Icon } from "astro-icon";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Contactform from "@components/contactform.astro";
import { useTranslations } from "@i18n/utils";

const lang = 'de';
const t = useTranslations(lang);
---

<Layout title={t('contact.title')}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t('contact.title')}</Fragment>
      <Fragment slot="desc">{t('contact.subtitle')}</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl">{t('contact.contact_studio')}</h2>
        <p class="text-lg leading-relaxed mt-3">
          {t('contact.contact_desc')}
        </p>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2">
            <Icon class="w-4 h-4" name="uil:map-marker" />
            <span>{t('common.location_full')}</span>
          </div>
          <div class="flex items-center mt-2 space-x-2">
            <Icon class="w-4 h-4" name="uil:envelope" /><a
              href="mailto:{t('common.email')}"
              >{t('common.email')}</a
            >
          </div>
        </div>
      </div>
      <div>
        <Contactform lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
