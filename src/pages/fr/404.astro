---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { useTranslations } from "@i18n/utils";

const lang = 'fr';
const t = useTranslations(lang);
---

<Layout title={t('404.title')}>
  <Container>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center">
      <div class="mt-16 text-center">
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
          {t('404.heading')}
        </h1>
        <p class="text-lg mt-4 text-slate-600">{t('404.message')}</p>
        <div class="mt-8">
          <a
            href="/fr/"
            class="bg-secondary text-white px-5 py-3 rounded-md hover:bg-opacity-90"
            >{t('404.back_home')}</a
          >
        </div>
      </div>
    </div>
  </Container>
</Layout>
